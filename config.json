                "pink": "#ab6d33"
            },
            "diff": {
                "add": "#484526",
                "delete": "#6e1f17",
                "change": "#3c4143",
                "text": "#64161e"
            },
            "code_selection": [
                "#34291b",
                "#3d2216"
            ],
            "comment": "#9b8545"
        }
    }
}
