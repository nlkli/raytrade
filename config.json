                "magenta": "#9a0b90",
                "cyan": "#00839c",
                "white": "#a79798",
                "orange": "#c0551b",
                "pink": "#bd6a67"
            },
            "diff": {
                "add": "#6bc07f",
                "delete": "#f8837d",
                "change": "#53add4",
                "text": "#d16cc9"
            },
            "code_selection": [
                "#dddddf",
                "#c4c4c4"
            ],
            "comment": "#86878c"
        }
    }
}
