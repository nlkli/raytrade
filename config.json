{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 90,
    "load_font": "resources/ComicRelief-Bold.ttf",
    "row_height": 20,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "s": 0.75,
            "m": 2
        },
        "a": {
            "type": "chart",
            "params": {}
        },
        "b": {
            "type": "orderbook_plus",
            "params": {},
            "a": {
                "type": "orderbook",
                "params": {
                    "vm": 1,
                    "rhd": 4
                }
            },
            "b": {
                "type": "orderbook",
                "params": {
                    "vm": 0,
                    "rhd": 4
                }
            }
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25"
    },
    "leader_key": " ",
    "binds": [
        [
            "f",
            "sub chart $ci F,$fc,1,300"
        ],
        [
            "b",
            "sub chart $ci F,$btc,1,300"
        ],
        [
            "c1",
            "set ci 0"
        ],
        [
            "c2",
            "set ci 1"
        ],
        [
            "sx]",
            "chart $ci sx +$css"
        ],
        [
            "sx[",
            "chart $ci sx -$css"
        ],
        [
            "sy]",
            "chart $ci sy +$css"
        ],
        [
            "sy[",
            "chart $ci sy -$css"
        ],
        [
            "tx]",
            "chart $ci tx +$cst"
        ],
        [
            "tx[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,1,300",
        "sub orderbook 0 F,$fc,200"
    ],
    "theme": {
        "name": "Mona Lisa",
        "is_light": false,
        "colors": {
            "background": [
                "#070405",
                "#120b0d",
                "#211418",
                "#311e23",
                "#4d2f37"
            ],
            "foreground": [
                "#ffdd6d",
                "#f7d66a",
                "#bca351",
                "#87753a"
            ],
            "selection": {
                "bg": "#f7d66a",
                "fg": "#120b0d"
            },
            "cursor": {
                "bg": "#c46c32",
                "fg": "#120b0d"
            },
            "base": {
                "black": "#351b0e",
                "red": "#9b291c",
                "green": "#636232",
                "yellow": "#c36e28",
                "blue": "#515c5d",
                "magenta": "#9b1d29",
                "cyan": "#588056",
                "white": "#f7d75c",
                "orange": "#af4c22",
                "pink": "#c9803c"
            },
            "bright": {
                "black": "#351b0e",
                "red": "#9b291c",
                "green": "#636232",
                "yellow": "#c36e28",
                "blue": "#515c5d",
                "magenta": "#9b1d29",
                "cyan": "#588056",
                "white": "#f7d75c",
                "orange": "#af4c22",
                "pink": "#c9803c"
            },
            "dim": {
                "black": "#2d170c",
                "red": "#842318",
