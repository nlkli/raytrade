{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 90,
    "load_font": "resources/ComicRelief-Bold.ttf",
    "row_height": 20,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "s": 0.8,
            "m": 2
        },
        "a": {
            "type": "split",
            "params": {
                "axis": 1,
                "s": 0.15,
                "m": 2
            },
            "a": {
                "type": "orderbook",
                "params": {
                    "vm": 0,
                    "rhd": 4
                }
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0,
                    "s": 0.5,
                    "m": 2
                },
                "a": {
                    "type": "chart",
                    "params": {}
                },
                "b": {
                    "type": "chart",
                    "params": {}
                }
            }
        },
        "b": {
            "type": "orderbook_plus",
            "params": {},
            "a": {
                "type": "orderbook",
                "params": {
                    "vm": 1,
                    "rhd": 4
                }
            },
            "b": {
                "type": "orderbook",
                "params": {
                    "vm": 0,
                    "rhd": 4
                }
            }
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25"
    },
    "leader_key": " ",
    "binds": [
        [
            "f",
            "sub chart $ci F,$fc,5,400"
        ],
        [
            "b",
            "sub chart $ci F,$btc,5,400"
        ],
        [
            "1",
            "set ci 0"
        ],
        [
            "2",
            "set ci 1"
        ],
        [
            "]",
            "chart $ci sx +$css"
        ],
        [
            "[",
            "chart $ci sx -$css"
        ],
        [
            "}",
            "chart $ci sy +$css"
        ],
        [
            "{",
            "chart $ci sy -$css"
        ],
        [
            "t]",
            "chart $ci tx +$cst"
        ],
        [
            "t[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,1,500",
        "sub chart 1 F,$btc,15,500",
        "sub orderbook 0 F,$fc,200",
        "sub orderbook 1 F,$btc,200"
    ],
    "theme": {
        "name": "Dark Pastel",
        "is_light": false,
        "colors": {
            "background": [
                "#0b0b0b",
                "#000000",
                "#0f0f0f",
                "#1f1f1f",
                "#3b3b3b"
            ],
            "foreground": [
                "#f0f0f0",
                "#ffffff",
                "#c4c4c4",
                "#8f8f8f"
            ],
            "selection": {
                "bg": "#b5d5ff",
                "fg": "#000000"
            },
            "cursor": {
                "bg": "#bbbbbb",
                "fg": "#ffffff"
            },
            "base": {
                "black": "#000000",
                "red": "#ff5555",
                "green": "#55ff55",
                "yellow": "#ffff55",
                "blue": "#5555ff",
                "magenta": "#ff55ff",
                "cyan": "#55ffff",
                "white": "#bbbbbb",
                "orange": "#ffaa55",
                "pink": "#dd8888"
            },
            "bright": {
                "black": "#000000",
                "red": "#ff5555",
                "green": "#55ff55",
                "yellow": "#ffff55",
                "blue": "#5555ff",
                "magenta": "#ff55ff",
                "cyan": "#55ffff",
                "white": "#bbbbbb",
                "orange": "#ffaa55",
                "pink": "#dd8888"
            },
            "dim": {
                "black": "#000000",
                "red": "#d94848",
                "green": "#48d948",
                "yellow": "#d9d948",
                "blue": "#4848d9",
                "magenta": "#d948d9",
                "cyan": "#48d9d9",
                "white": "#9f9f9f",
                "orange": "#d99148",
                "pink": "#bc7474"
            },
            "diff": {
                "add": "#39ab39",
                "delete": "#ab3939",
                "change": "#3939ab",
                "text": "#993399"
            },
            "code_selection": [
                "#262626",
                "#2d2d2d"
            ],
            "comment": "#999999"
        }
    }
}
