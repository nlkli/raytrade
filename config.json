{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 90,
    "load_font": "resources/ComicRelief-Bold.ttf",
    "row_height": 20,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "s": 0.75,
            "m": 2
        },
        "a": {
            "type": "chart",
            "params": {}
        },
        "b": {
            "type": "orderbook_plus",
            "params": {},
            "a": {
                "type": "orderbook",
                "params": {
                    "vm": 1,
                    "rhd": 4
                }
            },
            "b": {
                "type": "orderbook",
                "params": {
                    "vm": 0,
                    "rhd": 4
                }
            }
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25"
    },
    "binds": [
        [
            "f",
            "sub chart $ci F,$fc,1,300"
        ],
        [
            "b",
            "sub chart $ci F,$btc,1,300"
        ],
        [
            "c1",
            "set ci 0"
        ],
        [
            "c2",
            "set ci 1"
        ],
        [
            "sx]",
            "chart $ci sx +$css"
        ],
        [
            "sx[",
            "chart $ci sx -$css"
        ],
        [
            "sy]",
            "chart $ci sy +$css"
        ],
        [
            "sy[",
            "chart $ci sy -$css"
        ],
        [
            "tx]",
            "chart $ci tx +$cst"
        ],
        [
            "tx[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,1,300",
        "sub orderbook 0 F,$fc,200"
    ],
    "theme": {
        "name": "Terminal Basic",
        "is_light": true,
        "colors": {
            "background": [
                "#f4f4f4",
                "#ffffff",
                "#f0f0f0",
                "#e0e0e0",
                "#c4c4c4"
            ],
            "foreground": [
                "#0f0f0f",
                "#000000",
                "#3b3b3b",
                "#707070"
            ],
            "selection": {
                "bg": "#a4c9ff",
                "fg": "#000000"
            },
            "cursor": {
                "bg": "#7f7f7f",
                "fg": "#000000"
            },
            "base": {
                "black": "#000000",
                "red": "#990000",
                "green": "#00a600",
                "yellow": "#999900",
                "blue": "#0000b2",
                "magenta": "#b200b2",
                "cyan": "#00a6b2",
                "white": "#bfbfbf",
                "orange": "#994d00",
                "pink": "#ac6060"
            },
            "bright": {
                "black": "#000000",
                "red": "#990000",
                "green": "#00a600",
                "yellow": "#999900",
                "blue": "#0000b2",
                "magenta": "#b200b2",
                "cyan": "#00a6b2",
                "white": "#bfbfbf",
                "orange": "#994d00",
                "pink": "#ac6060"
            },
            "dim": {
                "black": "#000000",
                "red": "#820000",
                "green": "#008d00",
                "yellow": "#828200",
                "blue": "#000097",
                "magenta": "#970097",
                "cyan": "#008d97",
                "white": "#a2a2a2",
                "orange": "#824100",
                "pink": "#925151"
            },
            "diff": {
                "add": "#54c354",
                "delete": "#bb5454",
                "change": "#5454cb",
                "text": "#d166d1"
            },
            "code_selection": [
                "#d9d9d9",
                "#e0e0e0"
            ],
            "comment": "#666666"
        }
    }
}
