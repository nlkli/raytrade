                "magenta": "#d9d947",
                "cyan": "#d9d9d9",
                "white": "#a8a8a8",
                "orange": "#d9d947",
                "pink": "#c1c178"
            },
            "diff": {
                "add": "#f8bc44",
                "delete": "#f8bc44",
                "change": "#4d110c",
                "text": "#f7ad40"
            },
            "code_selection": [
                "#ed5244",
                "#ef642f"
            ],
            "comment": "#f7ada7"
        }
    }
}
