{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 90,
    "load_font": "resources/ComicRelief-Bold.ttf",
    "row_height": 20,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "s": 0.75,
            "m": 2
        },
        "a": {
            "type": "chart",
            "params": {}
        },
        "b": {
            "type": "orderbook_plus",
            "params": {},
            "a": {
                "type": "orderbook",
                "params": {
                    "vm": 1,
                    "rhd": 4
                }
            },
            "b": {
                "type": "orderbook",
                "params": {
                    "vm": 0,
                    "rhd": 4
                }
            }
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25"
    },
    "leader_key": " ",
    "binds": [
        [
            "f",
            "sub chart $ci F,$fc,1,300"
        ],
        [
            "b",
            "sub chart $ci F,$btc,1,300"
        ],
        [
            "c1",
            "set ci 0"
        ],
        [
            "c2",
            "set ci 1"
        ],
        [
            "]",
            "chart $ci sx +$css"
        ],
        [
            "[",
            "chart $ci sx -$css"
        ],
        [
            "}",
            "chart $ci sy +$css"
        ],
        [
            "{",
            "chart $ci sy -$css"
        ],
        [
            "t]",
            "chart $ci tx +$cst"
        ],
        [
            "t[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,1,300",
        "sub orderbook 0 F,$fc,200"
    ],
    "theme": {
        "name": "Matrix",
        "is_light": false,
        "colors": {
            "background": [
                "#090f11",
                "#0f191c",
                "#17272b",
                "#1f343b",
                "#2e4d57"
            ],
            "foreground": [
                "#4c754e",
                "#426644",
                "#1c2b1d",
                "#000000"
            ],
            "selection": {
                "bg": "#18282e",
                "fg": "#00ff87"
            },
            "cursor": {
                "bg": "#384545",
                "fg": "#00ff00"
            },
            "base": {
                "black": "#0f191c",
                "red": "#23755a",
                "green": "#82d967",
                "yellow": "#ffd700",
                "blue": "#3f5242",
                "magenta": "#409931",
                "cyan": "#50b45a",
                "white": "#507350",
                "orange": "#91a62d",
                "pink": "#3a7455"
            },
            "bright": {
                "black": "#0f191c",
                "red": "#23755a",
                "green": "#82d967",
                "yellow": "#ffd700",
                "blue": "#3f5242",
                "magenta": "#409931",
                "cyan": "#50b45a",
                "white": "#507350",
                "orange": "#91a62d",
                "pink": "#3a7455"
            },
            "dim": {
                "black": "#0d1518",
                "red": "#1e634d",
                "green": "#6fb858",
                "yellow": "#d9b700",
                "blue": "#364638",
                "magenta": "#36822a",
                "cyan": "#44994d",
                "white": "#446244",
                "orange": "#7b8d26",
                "pink": "#316348"
            },
            "diff": {
                "add": "#5c9a4e",
                "delete": "#1c5746",
                "change": "#2f3f35",
                "text": "#2c6629"
            },
            "code_selection": [
                "#172522",
                "#192426"
            ],
            "comment": "#2e4734"
        }
    }
}
