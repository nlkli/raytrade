{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 90,
    "load_font": "resources/ConcertOne-Regular.ttf",
    "row_height": 20,
    "show_overlay": true,
    "mouse_delta_factor": 1.5,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "size": 0.8
        },
        "a": {
            "type": "split",
            "params": {
                "axis": 1,
                "size": 0.1
            },
            "a": {
                "type": "orderbook",
                "params": {}
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0,
                    "size": 0.5
                },
                "a": {
                    "type": "chart",
                    "params": {}
                },
                "b": {
                    "type": "chart",
                    "params": {}
                }
            }
        },
        "b": {
            "type": "split",
            "params": {},
            "a": {
                "type": "orderbook",
                "params": {}
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0
                },
                "a": {
                    "type": "position",
                    "params": {}
                },
                "b": {
                    "type": "order",
                    "params": {}
                }
            }
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25"
    },
    "leader_key": " ",
    "binds": [
        [
            "f",
            "sub chart $ci F,$fc,5"
        ],
        [
            "b",
            "sub chart $ci F,$btc,5"
        ],
        [
            "1",
            "set ci 0"
        ],
        [
            "2",
            "set ci 1"
        ],
        [
            "]",
            "chart $ci sx +$css"
        ],
        [
            "[",
            "chart $ci sx -$css"
        ],
        [
            "}",
            "chart $ci sy +$css"
        ],
        [
            "{",
            "chart $ci sy -$css"
        ],
        [
            "t]",
            "chart $ci tx +$cst"
        ],
        [
            "t[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,1",
        "sub chart 1 F,$btc,15",
        "sub orderbook 0 F,$btc,200",
        "sub orderbook 1 F,$fc,200",
        "sub position F.$fc,F.$btc",
        "sub order F.$fc,F.$btc"
    ],
    "theme": {
        "name": "Solarized Dark Higher Contrast",
        "is_light": false,
        "colors": {
            "background": [
                "#00161c",
                "#001e27",
                "#002a36",
                "#003646",
                "#004b62"
            ],
            "foreground": [
                "#a8d1d2",
                "#9cc2c3",
                "#6d8888",
                "#425253"
            ],
            "selection": {
                "bg": "#003748",
                "fg": "#7a8f8e"
            },
            "cursor": {
                "bg": "#f34b00",
                "fg": "#002831"
            },
            "base": {
                "black": "#002831",
                "red": "#d11c24",
                "green": "#6cbe6c",
                "yellow": "#a57706",
                "blue": "#2176c7",
                "magenta": "#c61c6f",
                "cyan": "#259286",
                "white": "#eae3cb",
                "orange": "#bb4a15",
                "pink": "#de8078"
            },
            "bright": {
                "black": "#002831",
                "red": "#d11c24",
                "green": "#6cbe6c",
                "yellow": "#a57706",
                "blue": "#2176c7",
                "magenta": "#c61c6f",
                "cyan": "#259286",
                "white": "#eae3cb",
                "orange": "#bb4a15",
                "pink": "#de8078"
            },
            "dim": {
                "black": "#00222a",
                "red": "#b2181f",
                "green": "#5ca25c",
                "yellow": "#8c6505",
                "blue": "#1c64a9",
                "magenta": "#a8185e",
                "cyan": "#1f7c72",
                "white": "#c7c1ad",
                "orange": "#9f3e12",
                "pink": "#bc6c66"
            },
            "diff": {
                "add": "#488955",
                "delete": "#8c1d25",
                "change": "#165992",
                "text": "#771d52"
            },
            "code_selection": [
                "#17373e",
                "#3a291e"
            ],
            "comment": "#5e8085"
        }
    }
}
