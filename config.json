{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 60,
    "load_font": "resources/ConcertOne-Regular.ttf",
    "row_height": 20,
    "show_overlay": true,
    "mouse_delta_factor": 1.5,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "size": 0.85
        },
        "a": {
            "type": "split",
            "params": {
                "axis": 1,
                "size": 0.08
            },
            "a": {
                "type": "orderbook",
                "params": {}
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0,
                    "size": 0.6
                },
                "a": {
                    "type": "split",
                    "params": {
                        "axis": 1,
                        "size": 0.33
                    },
                    "a": {
                        "type": "chart",
                        "params": {
                            "sx": 0.33,
                            "tx": 10
                        }
                    },
                    "b": {
                        "type": "chart",
                        "params": {}
                    }
                },
                "b": {
                    "type": "split",
                    "params": {
                        "axis": 1,
                        "size": 0.33
                    },
                    "a": {
                        "type": "chart",
                        "params": {
                            "sx": 0.33,
                            "tx": 10
                        }
                    },
                    "b": {
                        "type": "chart",
                        "params": {}
                    }
                }
            }
        },
        "b": {
            "type": "split",
            "params": {
                "size": 0.42
            },
            "a": {
                "type": "orderbook",
                "params": {}
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0
                },
                "a": {
                    "type": "position",
                    "params": {}
                },
                "b": {
                    "type": "order",
                    "params": {}
                }
            }
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25",
        "instrument": "F,FARTCOINUSDT",
        "order_qty": "35",
        "place_long_limit_order_by_select_price": "porder L $instrument,L,$order_qty,BC,SP",
        "place_short_limit_order_by_select_price": "porder L $instrument,S,$order_qty,BC,SP",
        "place_long_limit_order_by_best_price": "porder L $instrument,L,$order_qty,BC,AP,0",
        "place_short_limit_order_by_best_price": "porder L $instrument,S,$order_qty,BC,BP,0",
        "cancel_selected_order": "corder SO"
    },
    "leader_key": " ",
    "binds": [
        [
            "<leader>c",
            "$cancel_selected_order"
        ],
        [
            "<leader>l",
            "$place_long_limit_order_by_best_price"
        ],
        [
            "<leader>s",
            "$place_short_limit_order_by_best_price"
        ],
        [
            ")",
            "$place_long_limit_order_by_select_price"
        ],
        [
            "(",
            "$place_short_limit_order_by_select_price"
        ],
        [
            "f",
            "sub chart $ci F,$fc,5"
        ],
        [
            "b",
            "sub chart $ci F,$btc,5"
        ],
        [
            "1",
            "set ci 0"
        ],
        [
            "2",
            "set ci 3"
        ],
        [
            "]",
            "chart $ci sx +$css"
        ],
        [
            "[",
            "chart $ci sx -$css"
        ],
        [
            "}",
            "chart $ci sy +$css"
        ],
        [
            "{",
            "chart $ci sy -$css"
        ],
        [
            "t]",
            "chart $ci tx +$cst"
        ],
        [
            "t[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,15",
        "sub chart 1 F,$fc,1",
        "sub chart 2 F,$btc,60",
        "sub chart 3 F,$btc,15",
        "sub orderbook 0 F,$btc,200",
        "sub orderbook 1 F,$fc,200",
        "sub position F.$fc,F.$btc",
        "sub order F.$fc,F.$btc"
    ],
    "theme": {
        "name": "Treehouse",
        "is_light": false,
        "colors": {
            "background": [
                "#0e0e0e",
                "#191919",
                "#282828",
                "#383838",
                "#545454"
            ],
            "foreground": [
                "#87795e",
                "#786b53",
                "#3d372a",
                "#080705"
            ],
            "selection": {
                "bg": "#786b53",
                "fg": "#fac800"
            },
            "cursor": {
                "bg": "#fac814",
                "fg": "#191919"
            },
            "base": {
