{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 60,
    "load_font": "resources/ConcertOne-Regular.ttf",
    "row_height": 20,
    "show_overlay": true,
    "mouse_delta_factor": 1.5,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "size": 0.85
        },
        "a": {
            "type": "split",
            "params": {
                "axis": 0,
                "size": 0.6
            },
            "a": {
                "type": "split",
                "params": {
                    "axis": 1,
                    "size": 0.33
                },
                "a": {
                    "type": "chart",
                    "params": {
                        "sx": 0.33,
                        "tx": 10,
                        "show_price_bar": false,
                        "show_time_line": false,
                        "show_grid": false
                    }
                },
                "b": {
                    "type": "chart",
                    "params": {
                        "sx": 0.5
                    }
                }
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 1,
                    "size": 0.33
                },
                "a": {
                    "type": "chart",
                    "params": {
                        "sx": 0.33,
                        "tx": 10,
                        "show_price_bar": false,
                        "show_time_line": false,
                        "show_grid": false
                    }
                },
                "b": {
                    "type": "chart",
                    "params": {
                        "sx": 0.5
                    }
                }
            }
        },
        "b": {
            "type": "split",
            "params": {
                "size": 0.42
            },
            "a": {
                "type": "orderbook",
                "params": {}
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0,
                    "size": 0.2
                },
                "a": {
                    "type": "position",
                    "params": {}
                },
                "b": {
                    "type": "split",
                    "params": {
                        "axis": 0,
                        "size": 0.8
                    },
                    "a": {
                        "type": "order",
                        "params": {}
                    },
                    "b": {
                        "type": "execution",
                        "params": {}
                    }
                }
            }
        }
    },
    "vars": {
        "coin": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "chart_scale_size": "0.09",
        "ci": "1",
        "instrument": "F,FARTCOINUSDT",
        "order_qty": "40",
        "place_long_limit_order_by_select_price": "porder L $instrument,L,$order_qty,BC,SP",
        "place_short_limit_order_by_select_price": "porder L $instrument,S,$order_qty,BC,SP",
        "place_long_limit_order_by_best_price": "porder L $instrument,L,$order_qty,BC,AP,0",
        "place_short_limit_order_by_best_price": "porder L $instrument,S,$order_qty,BC,BP,0",
        "cancel_selected_order": "corder S",
        "cancel_first_order": "corder F"
    },
    "leader_key": " ",
    "binds": [
        [
            "e",
            "chart $ci show_execution"
        ],
        [
            "u",
            "ulines"
        ],
        [
            "r",
            "read order_qty"
        ],
        [
            "1",
            "set order_qty 40"
        ],
        [
            "2",
            "set order_qty 80"
        ],
        [
            "3",
            "set order_qty 120"
        ],
        [
            "4",
            "set order_qty 240"
        ],
        [
            "<leader>x",
            "$cancel_selected_order"
        ],
        [
            "<leader>c",
            "$cancel_first_order"
        ],
        [
            "<leader>l",
            "$place_long_limit_order_by_best_price"
        ],
        [
            "<leader>s",
            "$place_short_limit_order_by_best_price"
        ],
        [
            "L",
            "$place_long_limit_order_by_select_price"
        ],
        [
            "S",
            "$place_short_limit_order_by_select_price"
        ],
        [
            "]",
            "chart $ci sx +$chart_scale_size"
        ],
        [
            "[",
            "chart $ci sx -$chart_scale_size"
        ],
        [
            "}",
            "chart $ci sy +$chart_scale_size"
        ],
        [
            "{",
            "chart $ci sy -$chart_scale_size"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$coin,15",
        "sub chart 1 F,$coin,1",
        "sub chart 2 F,$btc,240",
        "sub chart 3 F,$btc,15",
        "sub orderbook 0 F,$coin,200",
        "sub position F.$coin",
        "sub execution F.$coin",
        "sub order F.$coin"
    ],
    "theme": {
        "name": "Mirage",
        "is_light": false,
        "colors": {
            "background": [
                "#161f2d",
                "#1b2738",
                "#223247",
                "#2a3c57",
                "#375073"
            ],
            "foreground": [
                "#b3c0cf",
                "#a6b2c0",
                "#737c85",
                "#454a50"
            ],
            "selection": {
                "bg": "#273951",
                "fg": "#d3dbe5"
            },
            "cursor": {
                "bg": "#ddb3ff",
                "fg": "#ffffff"
            },
            "base": {
                "black": "#011627",
                "red": "#ff9999",
                "green": "#85cc95",
                "yellow": "#ffd700",
                "blue": "#7fb5ff",
                "magenta": "#ddb3ff",
                "cyan": "#21c7a8",
                "white": "#ffffff",
                "orange": "#ffb84d",
                "pink": "#ffcccc"
            },
            "bright": {
                "black": "#011627",
                "red": "#ff9999",
                "green": "#85cc95",
                "yellow": "#ffd700",
                "blue": "#7fb5ff",
                "magenta": "#ddb3ff",
                "cyan": "#21c7a8",
                "white": "#ffffff",
                "orange": "#ffb84d",
                "pink": "#ffcccc"
            },
            "dim": {
                "black": "#011321",
                "red": "#d98282",
                "green": "#71ad7f",
                "yellow": "#d9b700",
                "blue": "#6c9ad9",
                "magenta": "#bc98d9",
                "cyan": "#1ca98f",
                "white": "#d9d9d9",
                "orange": "#d99c41",
                "pink": "#d9adad"
            },
            "diff": {
                "add": "#629676",
                "delete": "#b47379",
                "change": "#5e86bd",
                "text": "#8f7baf"
            },
            "code_selection": [
                "#303c4c",
                "#4a4968"
            ],
            "comment": "#6e7a8a"
        }
    }
}
