{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 90,
    "load_font": "resources/ConcertOne-Regular.ttf",
    "row_height": 20,
    "show_overlay": true,
    "mouse_delta_factor": 1.5,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "size": 0.9
        },
        "a": {
            "type": "split",
            "params": {
                "axis": 1,
                "size": 0.1
            },
            "a": {
                "type": "orderbook",
                "params": {}
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0,
                    "size": 0.5
                },
                "a": {
                    "type": "chart",
                    "params": {}
                },
                "b": {
                    "type": "chart",
                    "params": {}
                }
            }
        },
        "b": {
            "type": "orderbook",
            "params": {}
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25"
    },
    "leader_key": " ",
    "binds": [
        [
            "f",
            "sub chart $ci F,$fc,5"
        ],
        [
            "b",
            "sub chart $ci F,$btc,5"
        ],
        [
            "1",
            "set ci 0"
        ],
        [
            "2",
            "set ci 1"
        ],
        [
            "]",
            "chart $ci sx +$css"
        ],
        [
            "[",
            "chart $ci sx -$css"
        ],
        [
            "}",
            "chart $ci sy +$css"
        ],
        [
            "{",
            "chart $ci sy -$css"
        ],
        [
            "t]",
            "chart $ci tx +$cst"
        ],
        [
            "t[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,1",
        "sub chart 1 F,$btc,15",
        "sub orderbook 0 F,$fc,200",
        "sub orderbook 1 F,$btc,200"
    ],
    "theme": {
        "name": "One Double Light",
        "is_light": true,
        "colors": {
            "background": [
                "#efefef",
                "#fafafa",
                "#ebebeb",
                "#dbdbdb",
                "#bfbfbf"
            ],
            "foreground": [
                "#2b2d34",
                "#383a43",
                "#696d7e",
                "#969bb3"
            ],
            "selection": {
                "bg": "#454e5e",
                "fg": "#1a1919"
            },
            "cursor": {
                "bg": "#1a1919",
                "fg": "#dbdfe5"
            },
            "base": {
                "black": "#454b58",
                "red": "#f74840",
                "green": "#25a343",
                "yellow": "#cc8100",
                "blue": "#0087c1",
                "magenta": "#b50da9",
                "cyan": "#009ab7",
                "white": "#c5b2b3",
                "orange": "#e26520",
                "pink": "#de7d7a"
            },
            "bright": {
                "black": "#454b58",
                "red": "#f74840",
                "green": "#25a343",
                "yellow": "#cc8100",
                "blue": "#0087c1",
                "magenta": "#b50da9",
                "cyan": "#009ab7",
                "white": "#c5b2b3",
                "orange": "#e26520",
                "pink": "#de7d7a"
            },
            "dim": {
                "black": "#3b404b",
                "red": "#d23d36",
                "green": "#1f8b39",
                "yellow": "#ad6e00",
