{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 90,
    "load_font": "resources/ComicRelief-Bold.ttf",
    "row_height": 32,
    "show_overlay": true,
    "mouse_delta_factor": 1.5,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "size": 0.9
        },
        "a": {
            "type": "split",
            "params": {
                "axis": 1,
                "size": 0.1
            },
            "a": {
                "type": "orderbook",
                "params": {}
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0,
                    "size": 0.5
                },
                "a": {
                    "type": "chart",
                    "params": {}
                },
                "b": {
                    "type": "chart",
                    "params": {}
                }
            }
        },
        "b": {
            "type": "orderbook",
            "params": {}
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25"
    },
    "leader_key": " ",
    "binds": [
        [
            "f",
            "sub chart $ci F,$fc,5"
        ],
        [
            "b",
            "sub chart $ci F,$btc,5"
        ],
        [
            "1",
            "set ci 0"
        ],
        [
            "2",
            "set ci 1"
        ],
        [
            "]",
            "chart $ci sx +$css"
        ],
        [
            "[",
            "chart $ci sx -$css"
        ],
        [
            "}",
            "chart $ci sy +$css"
        ],
        [
            "{",
            "chart $ci sy -$css"
        ],
        [
            "t]",
            "chart $ci tx +$cst"
        ],
        [
            "t[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,1",
        "sub chart 1 F,$btc,15",
        "sub orderbook 0 F,$fc,200",
        "sub orderbook 1 F,$btc,200"
    ],
    "theme": {
        "name": "Hot Dog Stand",
        "is_light": true,
        "colors": {
            "background": [
                "#f53525",
                "#ea3323",
                "#db3021",
                "#cb2c1e",
                "#af261a"
            ],
            "foreground": [
                "#f0f0f0",
                "#ffffff",
                "#ffffff",
                "#ffffff"
            ],
            "selection": {
                "bg": "#ffff54",
                "fg": "#000000"
            },
            "cursor": {
                "bg": "#ffff54",
                "fg": "#ea3323"
            },
            "base": {
                "black": "#000000",
                "red": "#ffff54",
                "green": "#ffff54",
                "yellow": "#ffff54",
                "blue": "#000000",
                "magenta": "#ffff54",
                "cyan": "#ffffff",
                "white": "#c6c6c6",
                "orange": "#ffff54",
                "pink": "#e3e38d"
            },
            "bright": {
                "black": "#000000",
                "red": "#ffff54",
                "green": "#ffff54",
                "yellow": "#ffff54",
                "blue": "#000000",
                "magenta": "#ffff54",
                "cyan": "#ffffff",
                "white": "#c6c6c6",
                "orange": "#ffff54",
                "pink": "#e3e38d"
            },
            "dim": {
                "black": "#000000",
                "red": "#d9d947",
                "green": "#d9d947",
                "yellow": "#d9d947",
