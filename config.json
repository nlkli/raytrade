{
    "init_window": {
        "width": 800,
        "height": 600,
        "title": "raytrade"
    },
    "target_fps": 90,
    "load_font": "resources/ComicRelief-Bold.ttf",
    "row_height": 20,
    "mouse_delta_factor": 1.5,
    "layout": {
        "type": "split",
        "params": {
            "axis": 1,
            "s": 0.8,
            "m": 2
        },
        "a": {
            "type": "split",
            "params": {
                "axis": 1,
                "s": 0.15,
                "m": 2
            },
            "a": {
                "type": "orderbook",
                "params": {
                    "vm": 0,
                    "rhd": 4
                }
            },
            "b": {
                "type": "split",
                "params": {
                    "axis": 0,
                    "s": 0.5,
                    "m": 2
                },
                "a": {
                    "type": "chart",
                    "params": {}
                },
                "b": {
                    "type": "chart",
                    "params": {}
                }
            }
        },
        "b": {
            "type": "orderbook_plus",
            "params": {},
            "a": {
                "type": "orderbook",
                "params": {
                    "vm": 1,
                    "rhd": 4
                }
            },
            "b": {
                "type": "orderbook",
                "params": {
                    "vm": 0,
                    "rhd": 4
                }
            }
        }
    },
    "vars": {
        "fc": "FARTCOINUSDT",
        "btc": "BTCUSDT",
        "ci": "0",
        "css": "0.09",
        "cst": "25"
    },
    "leader_key": " ",
    "binds": [
        [
            "f",
            "sub chart $ci F,$fc,5"
        ],
        [
            "b",
            "sub chart $ci F,$btc,5"
        ],
        [
            "1",
            "set ci 0"
        ],
        [
            "2",
            "set ci 1"
        ],
        [
            "]",
            "chart $ci sx +$css"
        ],
        [
            "[",
            "chart $ci sx -$css"
        ],
        [
            "}",
            "chart $ci sy +$css"
        ],
        [
            "{",
            "chart $ci sy -$css"
        ],
        [
            "t]",
            "chart $ci tx +$cst"
        ],
        [
            "t[",
            "chart $ci tx -$cst"
        ]
    ],
    "init_commands": [
        "sub chart 0 F,$fc,1",
        "sub chart 1 F,$btc,15",
        "sub orderbook 0 F,$fc,200",
        "sub orderbook 1 F,$btc,200"
    ],
    "theme": {
        "name": "Flat",
        "is_light": false,
        "colors": {
            "background": [
                "#001c35",
                "#002240",
                "#002a4f",
                "#00325f",
                "#00417b"
            ],
            "foreground": [
                "#2fd464",
                "#2cc55d",
                "#1f8a41",
                "#135528"
            ],
            "selection": {
                "bg": "#792b9c",
                "fg": "#ffffff"
            },
            "cursor": {
                "bg": "#e5be0c",
                "fg": "#ffffff"
            },
            "base": {
                "black": "#222d3f",
                "red": "#a82320",
                "green": "#32a548",
                "yellow": "#e58d11",
                "blue": "#3167ac",
                "magenta": "#781aa0",
                "cyan": "#2c9370",
                "white": "#b0b6ba",
                "orange": "#c75819",
                "pink": "#ac6d6d"
            },
            "bright": {
                "black": "#222d3f",
                "red": "#a82320",
                "green": "#32a548",
                "yellow": "#e58d11",
                "blue": "#3167ac",
                "magenta": "#781aa0",
                "cyan": "#2c9370",
                "white": "#b0b6ba",
                "orange": "#c75819",
                "pink": "#ac6d6d"
            },
            "dim": {
                "black": "#1d2636",
                "red": "#8f1e1b",
                "green": "#2b8c3d",
                "yellow": "#c3780e",
                "blue": "#2a5892",
                "magenta": "#661688",
                "cyan": "#257d5f",
                "white": "#969b9e",
                "orange": "#a94b15",
                "pink": "#925c5d"
            },
            "diff": {
                "add": "#217a45",
                "delete": "#71232b",
                "change": "#215088",
                "text": "#481d7a"
            },
            "code_selection": [
                "#073a44",
                "#374734"
            ],
            "comment": "#1a8451"
        }
    }
}
